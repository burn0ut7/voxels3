+	SamplerState TerrainSampler < Filter( ANISOTROPIC ); MaxAniso( 16 ); AddressU( WRAP ); AddressV( WRAP ); >;
+	struct TerrainSample
+	{
+		float3 Color;
+		float3 Normal;
+		float2 Surface;
+	};
+
+	TerrainSample SampleTerrainLive( Texture2D colorMap, Texture2D normalMap, float2 uv, float2 gradientX, float2 gradientY, float contribution )
+	{
+		TerrainSample result = (TerrainSample)0;
+		[branch]
+		if ( contribution <= 0.0 )
+		{
+			return result;
+		}
+		// Two continuous UV projections; smooth periodic noise selects their mix.
+		float2 cell = floor( uv * 0.5 );
+		float2 fraction = frac( uv * 0.5 );
+		fraction = fraction * fraction * (3.0 - 2.0 * fraction);
+		uint4 x = asuint( (int4)float4( cell.x, cell.x + 1.0, cell.x, cell.x + 1.0 ) ) & 3u;
+		uint4 y = asuint( (int4)float4( cell.y, cell.y, cell.y + 1.0, cell.y + 1.0 ) ) & 3u;
+		uint4 hash = (x * 0x8DA6B343u) ^ (y * 0xD8163841u);
+		hash ^= hash >> 16;
+		hash *= 0x7FEB352Du;
+		hash ^= hash >> 15;
+		float4 noise = float4( hash & 65535u ) / 65535.0;
+		float blend = smoothstep( 0.2, 0.8,
+			lerp( lerp( noise.x, noise.y, fraction.x ), lerp( noise.z, noise.w, fraction.x ), fraction.y ) );
+		float2 rotatedUv = float2( -uv.y, uv.x ) + float2( 0.371, 0.713 );
+		float2 rotatedX = float2( -gradientX.y, gradientX.x );
+		float2 rotatedY = float2( -gradientY.y, gradientY.x );
+		float4 color0 = colorMap.SampleGrad( TerrainSampler, uv, gradientX, gradientY );
+		float4 color1 = colorMap.SampleGrad( TerrainSampler, rotatedUv, rotatedX, rotatedY );
+		float4 normal0 = normalMap.SampleGrad( TerrainSampler, uv, gradientX, gradientY );
+		float4 normal1 = normalMap.SampleGrad( TerrainSampler, rotatedUv, rotatedX, rotatedY );
+		float3 direction0 = normal0.xyz * 2.0 - 1.0;
+		float3 direction1 = normal1.xyz * 2.0 - 1.0;
+		direction1.xy = float2( direction1.y, -direction1.x );
+		result.Color = lerp( color0.rgb, color1.rgb, blend );
+		result.Surface = lerp( float2( color0.a, normal0.a ), float2( color1.a, normal1.a ), blend );
+		result.Normal = lerp( direction0, direction1, blend );
