+HEADER
+{
+	Description = "Bounded terrain material pattern cache";
+}
+MODES
+{
+	Default();
+}
+FEATURES
+{
+}
+COMMON
+{
+	#include "system.fxc"
+}
+CS
+{
+	#include "common.fxc"
+	#include "shaders/voxels/voxel_pattern_shared.hlsl"
+	Texture2D SourceColor < Attribute( "SourceColor" ); SrgbRead( true ); >;
+	Texture2D SourceNormal < Attribute( "SourceNormal" ); SrgbRead( false ); >;
+	RWTexture2DArray<float4> CacheOutput < Attribute( "CacheOutput" ); >;
+	int MaterialIndex < Attribute( "MaterialIndex" ); >;
+	int OutputSize < Attribute( "OutputSize" ); >;
+	[numthreads( 8, 8, 1 )]
+	void MainCs( uint3 threadId : SV_DispatchThreadID )
+	{
+		if ( threadId.x >= OutputSize || threadId.y >= OutputSize )
+		{
+			return;
+		}
+		float2 uv = (float2( threadId.xy ) + 0.5) * (8.0 / float( OutputSize ));
+		TerrainSample value = SampleTerrainLive( SourceColor, SourceNormal, uv,
+			float2( 8.0 / float( OutputSize ), 0.0 ), float2( 0.0, 8.0 / float( OutputSize ) ), 1.0 );
+		CacheOutput[uint3( threadId.xy, MaterialIndex * 2 )] = float4( value.Color, value.Surface.x );
+		CacheOutput[uint3( threadId.xy, MaterialIndex * 2 + 1 )] = float4( value.Normal * 0.5 + 0.5, value.Surface.y );
+	}
+}
