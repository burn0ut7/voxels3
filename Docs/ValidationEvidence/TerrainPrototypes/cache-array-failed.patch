+using Sandbox.Rendering;
+
+// Derived source-material patterns. No world/edit state is stored here.
+internal sealed class TerrainPatternCache : System.IDisposable
+{
+	private readonly Texture _texture;
+	private readonly Texture[] _sources = new Texture[10];
+	private readonly ComputeShader _shader = new( "shaders/voxels/voxel_pattern_cache_cs.shader" );
+	private int _nextMaterial;
+	private bool _failed;
+	private bool _sourceLogged;
+	public bool Ready { get; private set; }
+
+	public TerrainPatternCache( Material material )
+	{
+		string[] names = ["Grass", "Dirt", "Stone", "Snow", "Sand"];
+		for ( var index = 0; index < names.Length; index++ )
+		{
+			_sources[index * 2] = material.GetTexture( names[index] + "ColorMap" );
+			_sources[index * 2 + 1] = material.GetTexture( names[index] + "NormalMap" );
+			if ( _sources[index * 2] is null || _sources[index * 2 + 1] is null )
+				throw new System.InvalidOperationException( $"Missing packed terrain maps: {names[index]}" );
+		}
+		Log.Info( $"[TerrainPatternCache] packed source={_sources[0].ResourcePath}" );
+		var builder = Texture.CreateArray( 1024, 1024, 10, ImageFormat.RGBA16161616F );
+		builder.WithMips( 11 );
+		builder.WithUAVBinding();
+		_texture = builder.Finish();
+		Log.Info( "[TerrainPatternCache] allocated1024x1024x10 RGBA16F full mips; logicalBytes=111848080" );
+	}
+
+	public bool Advance()
+	{
+		if ( !_sourceLogged )
+		{
+			_sourceLogged = true;
+			for ( var i = 0; i < _sources.Length; i++ )
+				Log.Info( $"[TerrainPatternCache] input{i} size={_sources[i].Width}x{_sources[i].Height} name={_sources[i].ResourceName}" );
+		}
+		if ( Ready || _failed ) return false;
+		try
+		{
+		_shader.Attributes.Set( "SourceColor", _sources[_nextMaterial * 2] );
+		_shader.Attributes.Set( "SourceNormal", _sources[_nextMaterial * 2 + 1] );
+		_shader.Attributes.Set( "MaterialIndex", _nextMaterial );
+		for ( var mip = 0; mip < 11; mip++ )
+		{
+			var size = 1024 >> mip;
+			_shader.Attributes.Set( "CacheOutput", _texture, mip );
+			_shader.Attributes.Set( "OutputSize", size );
+			Graphics.ResourceBarrierTransition( _texture, ResourceState.UnorderedAccess, mip );
+			_shader.Dispatch( size, size, 1 );
+			Graphics.UavBarrier( _texture );
+			Graphics.ResourceBarrierTransition( _texture, ResourceState.GenericRead, mip );
+		}
+		_nextMaterial++;
+		if ( _nextMaterial != 5 ) return false;
+		Graphics.ResourceBarrierTransition( _texture, ResourceState.GenericRead );
+		Graphics.ResourceBarrierTransition( _texture, ResourceState.GenericRead );
+		Ready = true;
+		Log.Info( "[TerrainPatternCache] ready materials=5 periodUV=8" );
+		return true;
+		}
+		catch ( System.Exception exception )
+		{
+			_failed = true;
+			Log.Warning( $"[TerrainPatternCache] generation failed: {exception}" );
+			return false;
+		}
+	}
+
+	public void Bind( RenderAttributes attributes )
+	{
+		attributes.Set( "TerrainPatternCache", _texture );
+		attributes.Set( "TerrainPatternCacheReady", Ready ? 1 : 0 );
+	}
+
+	public void Dispose() => _texture?.Dispose();
+}
